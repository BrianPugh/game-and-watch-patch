# --- RAM
0x20001034 data g_state                               # main game-state struct
0x2000103d data g_state_transition                    # g_state+9: 0 idle,1/2 reload,3 begin switch,4 covering,5 uncovering
0x20001044 data g_gnw_mode                            # u16: 0x02 clock,0x04 mario-song,0x08 BALL,0x10 SMB1,0x20 SMB2,0x40 first-boot "PRESS TIME" screen (observed 0x52 in GWemu); 0x80 UNVERIFIED (set on 3-min idle -> likely sleep-screen); 0x01 UNKNOWN (no sleep, skips UI)
0x20010694 data ui_state                              # 0 none, 4 opening (c584), 5 open, 6 closing (c5d2), 7 cover-start (c604), 9 uncover-start (c62e); 8 = cover done (main loop waits for it); exact animation sub-states UNVERIFIED
0x20010698 data ui_game_select_choice                 # u16 mode value under cursor
0x2001069a data ui_is_game_select                     # 1 = game-select overlay, 0 = settings overlay
0x200106a0 data ui_blink_counter
0x200106a5 data ui_req_clock                          # set by TIME in game-select
0x200106a6 data ui_req_switch_game                    # set by A in game-select if choice != current
0x20010f18 data ui_font_ptr
# RAM never written by stock fw (GWemu canary probe 2026-10-15: boot, clock, SMB1, SMB2, BALL, pause menu; mario song / sleep images / nvram UNVERIFIED)
0x00002cc0 data itcm_unused                           # to 0x00008000 (21312 B)
#   AHB 0x3001e0c0-0x3001f800 (5952 B) also unused (AHB SRAM is not mapped in the RE ELF)
#   AHB 0x3001fbf0-0x30020000 (1040 B) also unused
#   AHB 0x300145b0-0x3001e000 (39504 B): tail of our linker RAM region (__RAM_ORIGIN__/__RAM_LENGTH__) beyond our .data/.bss/stack; stock never writes it
#   AHB 0x30000000-0x30010000 and AXI 0x2408efe0-0x24098fe0: written in some runs only (look like audio buffers); treat as used. Re-run: tools/emu/ram_probe.py
# --- external flash (decrypted)
